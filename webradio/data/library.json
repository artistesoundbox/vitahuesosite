    "aka": "Vita Hueso"
  },
  "albums": [
    {
      "id": "vol1",
      "title": "I See God in You",
      "cover": "assets/covers/album1.jpg",
      "year": 2025,
      "description": "The first transmission. Eleven songs about being seen, being held, and coming back to yourself."
    },
    {
      "id": "vol2",
      "title": "Still Waters",
      "cover": "assets/covers/album2.jpg",
      "year": 2025,
      "description": "A quieter room. Slow water, reflections, forgiveness, and the parts of you that waited."
    },
    {
      "id": "vol3",
      "title": "New Edges",
      "cover": "assets/covers/album3.jpg",
      "year": 2026,
      "description": "Movement and momentum. Choosing yourself, again and again, in a slightly firmer voice."
    },
    {
      "id": "vol4",
      "title": "En Español",
      "cover": "assets/covers/album4.jpg",
      "year": 2026,
      "description": "Tres canciones en español. Flow, blue light, and galaxies that keep a beat."
    },
    {
      "id": "vol5",
      "title": "Simply Be",
      "cover": "assets/covers/album5.jpg",
      "year": 2026,
      "description": "Lo-fi mantras and small victories. Music for the soft hour before sleep."
    },
    {
      "id": "cc-sessions",
      "title": "Signal Sessions (CC)",
      "cover": "assets/art/free-cover.svg",
      "year": 2026,
      "description": "Guest songs and instrumentals from independent artists under Creative Commons Attribution licences — rock, pop, soul, funk, hip-hop, jazz, latin, country, reggae, folk, blues and electronic, woven through the live rotation.",
      "external": true
    },
    {
      "id": "open-shelf",
      "title": "Open Shelf",
      "cover": "assets/art/open-shelf-cover.svg",
      "year": 2026,
      "description": "Afrobeat, amapiano, boogie and latin instrumentals picked from the Free Music Archive — CC BY and CC BY-SA, so the station can broadcast them with credit.",
      "external": true
    }
  ],
