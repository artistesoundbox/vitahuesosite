 "ps" : "3:10", "br" : "VBR"}, "file_extra" : {"ccud" : "multiple_formats", "type" : "multiple_formats", "sha1" : "5FDHSBHIJ2RQCIZLVGAI5XAOVWMUSC2X"}, "file_filesize" : " (10.38MB)", "file_order" : 1, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/mwic/mwic_-_Lamadio_at_15.flac", "local_path" : "/var/www/ccmixter/content/mwic/mwic_-_Lamadio_at_15.flac", "file_rawsize" : 10883344}], "upload_description_plain" : "Susan's remix from Sep 2011 was used in a *lot* of videos.. not sure whether there's a story behind that, but we *love* it when people use our music in videos.\r\n\r\nThis is my first remix using my new best buddy, REAPER. It's exciting stuff because of a top-secret project I'm coding up. Reaper people (reaple?) reply and I'll let you in on the details... ", "upload_description_html" : "Susan&#8217;s remix from Sep 2011 was used in a *lot* of videos.. not sure whether there&#8217;s a story behind that, but we *love* it when people use our music in videos.<br />\r\n<br />\r\nThis is my first remix using my new best buddy, REAPER. It&#8217;s exciting stuff because of a top-secret project I&#8217;m coding up. Reaper people (reaple?) reply and I&#8217;ll let you in on the details&#8230; "},{"upload_id" : 70326, "upload_name" : "Lamadio Tiado (Hot Cha Cha Mix)", "upload_extra" : {"usertags" : "salsa,mexican,music_for_film,jazz,trip_hop,funky,downtempo,chill", "ccud" : "media,remix,bpm_090_095,ccplus", "systags" : "attribution,audio,mp3,44k,stereo,VBR", "bpm" : 90, "relative_dir" : "content/Coruscate", "featuring" : "", "ccplus" : true, "nsfw" : false, "num_reviews" : 1}, "user_name" : "Coruscate", "upload_tags" : ",media,remix,bpm_090_095,ccplus,attribution,audio,mp3,44k,stereo,VBR,salsa,mexican,music_for_film,jazz,trip_hop,funky,downtempo,chill,", "upload_num_scores" : 5, "file_page_url" : "https://ccmixter.org/files/Coruscate/70326", "user_real_name" : "coruscate", "artist_page_url" : "https://ccmixter.org/people/Co