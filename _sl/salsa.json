"file_nicname" : "stems", "file_format_info" : {"media-type" : "archive", "format-name" : "archive-zip-", "default-ext" : "zip", "mime_type" : "application/zip", "zipdir" : {"files" : ["/bass drum.mp3  (2.17MB)", "/Bass.mp3  (2.17MB)", "/bongo.mp3  (2.17MB)", "/Chequere.mp3  (2.17MB)", "/electric guitar.mp3  (2.17MB)", "/Ewe - Toke.mp3  (2.17MB)", "/HiHat 2.mp3  (2.17MB)", "/HiHat.mp3  (2.17MB)", "/Hype Disbelief Kit.mp3  (2.17MB)", "/shaker.mp3  (2.17MB)", "/snare.mp3  (2.17MB)", "/Tambourine.mp3  (2.17MB)"]}}, "file_extra" : {"sha1" : "UOYETHFLJAGOHMZQNQ3UNNC6O4LT6UUM"}, "file_filesize" : " (21.28MB)", "file_order" : 2, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/JeffSpeed68/JeffSpeed68_-_Salsa_1.zip", "local_path" : "/var/www/ccmixter/content/JeffSpeed68/JeffSpeed68_-_Salsa_1.zip", "file_rawsize" : 22313561}], "upload_description_plain" : "Drums percussions and bass guitar\r\nbpm 130", "upload_description_html" : "Drums percussions and bass guitar<br />\r\nbpm 130"},{"upload_id" : 56569, "upload_name" : "Badabing Badaboom Estilo Latino", "upload_extra" : {"usertags" : "guitar,drums,bass,piano,saxophone,trumpet,brass,trombone,big_band_latin_jazz,spoken_word,salsa,galveston_county,texas", "ccud" : "media,remix,bpm_120_125,trackback,in_video,in_podcast", "systags" : "non_commercial,audio,mp3,44k,stereo,CBR", "nsfw" : false, "relative_dir" : "content/texasradiofish", "bpm" : 120, "featuring" : "Copperhead, SackJo22", "last_op" : "replace", "num_reviews" : 5}, "user_name" : "texasradiofish", "upload_tags" : ",media,remix,bpm_120_125,trackback,in_video,in_podcast,non_commercial,audio,mp3,44k,stereo,CBR,guitar,drums,bass,piano,saxophone,trumpet,brass,trombone,big_band_latin_jazz,spoken_word,salsa,galveston_county,texas,", "upload_num_scores" : 17, "file_page_url" : "https://ccmixter.org/files/texasradiofish/56569", "user_real_name" : "texasradiofish", "artist_page_url" : "https://ccmixter.org/people/texasradiofish", "license_logo_url" : "https://ccmixter.org/ccskins/shared/images/lics/small-by-nc-3.png", "license_url" : "http://creativecommons.org/licenses/by-nc/3.0/", "license_name" : "Attribution Noncommercial  (3.0)", "upload_date_format" : "Sat, Sep 23, 2017 @ 11:08 PM", "files" : [{"file_id" : 91953, "file_upload" : 56569, "file_name" : "texasradiofish_-_Badabing_Badaboom_Estilo_Latino.mp3", "file_nicname" : "mp3", "file_format_info" : {"media-type" : "audio", "format-name" : "audio-mp3-mp3", "default-ext" : "mp3", "mime_type" : "audio/mpeg", "sr" : "44k", "ch" : "stereo", "ps" : "3:18", "br" : "CBR"}, "file_extra" : {"sha1" : "KFKWDUR3PSUA4AV2BWSSRN4NYG3CBZEJ", "ccud" : "", "type" : ""}, "file_filesize" : " (7.57MB)", "file_order" : 0, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/texasradiofish/texasradiofish_-_Badabing_Badaboom_Estilo_Latino.mp3", "local_path" : "/var/www/ccmixter/content/texasradiofish/texasradiofish_-_Badabing_Badaboom_Estilo_Latino.mp3", "file_rawsize" : 7936044}], "upload_description_plain" : "This is the third TRF remix of Badabing Badaboom. This remix shortens the big band latin jazz arrangement in our second remix using Susan's pell and flips the vocals roles with copperhead's pell in the lead and Susan as the backing vocal. This version also emphasizes vocal verses over the instrument choruses.\r\n\r\nLyrics\r\n\r\nPhil Rizuto had his holy cow\r\nBatman and Robin went boom kapow. \r\nRalph Kramen tells Alice, bang zoom to the moon,\r\nIt’s just their way of saying\r\n\r\nBadabing badaboom\r\n\r\nSpeak into the mic put the lens on zoom etc.\r\n\r\nWaitin 15 minutes for the Drive-thru clerk\r\nFood is all cold and the Slurpee don’t work\r\nYou go to complain but they closed at noon\r\nTime to serve ‘em up Badabing-Badaboom\r\n\r\nBadabing badaboom\r\n\r\nSo life really kicked you when you were down\r\nYou caught your best friend with your girl downtown\r\nBuying her chocolates and French Perfume?\r\nGive ‘em both a present: Badabing-Badaboom\r\n\r\nBadabing-badaboom \r\nSpeak into the mic put the lens on zoom etc.\r\n\r\nFlyin down the freeway crusin in third\r\nSome guy cuts you off and flips you the bird\r\nJust drop it down to second and vroom vroom vroom\r\nAnd when you catch up Badabing-Badaboom\r\n\r\nWatchin Jerry Springer for a good laugh\r\nSome girl in a hoodie is talkin some trash \r\nShe married some guy but on the honeymoon\r\nShe found out he’s a SHE Bada Bing Bada Boom!", "upload_description_html" : "This is the third TRF remix of Badabing Badaboom. This remix shortens the big band latin jazz arrangement in our second remix using Susan&#8217;s pell and flips the vocals roles with copperhead&#8217;s pell in the lead and Susan as the backing vocal. This version also emphasizes vocal verses over the instrument choruses.<br />\r\n<br />\r\n<span class=\"u\">Lyrics</span><br />\r\n<br />\r\nPhil Rizuto had his holy cow<br />\r\nBatman and Robin went boom kapow. <br />\r\nRalph Kramen tells Alice, bang zoom to the moon,<br />\r\nIt’s just their way of saying<br />\r\n<br />\r\nBadabing badaboom<br />\r\n<br />\r\nSpeak into the mic put the lens on zoom etc.<br />\r\n<br />\r\nWaitin 15 minutes for the Drive-thru clerk<br />\r\nFood is all cold and the Slurpee don’t work<br />\r\nYou go to complain but they closed at noon<br />\r\nTime to serve ‘em up Badabing-Badaboom<br />\r\n<br />\r\nBadabing badaboom<br />\r\n<br />\r\nSo life really kicked you when you were down<br />\r\nYou caught your best friend with your girl downtown<br />\r\nBuying her chocolates and French Perfume?<br />\r\nGive ‘em both a present: Badabing-Badaboom<br />\r\n<br />\r\nBadabing-badaboom <br />\r\nSpeak into the mic put the lens on zoom etc.<br />\r\n<br />\r\nFlyin down the freeway crusin in third<br />\r\nSome guy cuts you off and flips you the bird<br />\r\nJust drop it down to second and vroom vroom vroom<br />\r\nAnd when you catch up Badabing-Badaboom<br />\r\n<br />\r\nWatchin Jerry Springer for a good laugh<br />\r\nSome girl in a hoodie is talkin some trash <br />\r\nShe married some guy but on the honeymoon<br />\r\nShe found out he’s a SHE Bada Bing Bada Boom!"},{"upload_id" : 50647, "upload_name" : "Round Salsa", "upload_extra" : {"usertags" : "midi,tracker,retro,cellphone,rondo,salsa", "ccud" : "sample,media", "systags" : "non_commercial,audio,mp3,48k,stereo,CBR", "featuring" : "", "relative_dir" : "content/skoria", "bpm" : "", "nsfw" : false}, "user_name" : "skoria", "upload_tags" : ",sample,media,non_commercial,audio,mp3,48k,stereo,CBR,midi,tracker,retro,cellphone,rondo,salsa,", "file_page_url" : "https://ccmixter.org/files/skoria/50647", "user_real_name" : "skoria", "artist_page_url" : "https://ccmixter.org/people/skoria", "license_logo_url" : "https://ccmixter.org/ccskins/shared/images/lics/small-by-nc-3.png", "license_url" : "http://creativecommons.org/licenses/by-nc/3.0/", "license_name" : "Attribution Noncommercial  (3.0)", "upload_date_format" : "Tue, Jun 23, 2015 @ 7:01 AM", "files" : [{"file_id" : 78130, "file_upload" : 50647, "file_name" : "skoria_-_Round_Salsa.mp3", "file_nicname" : "mp3", "file_format_info" : {"media-type" : "audio", "format-name" : "audio-mp3-mp3", "default-ext" : "mp3", "mime_type" : "audio/mpeg", "sr" : "48k", "ch" : "stereo", "ps" : "0:55", "br" : "CBR"}, "file_extra" : {"sha1" : "JSB76ZG3NDELMSLQHZU5E4J7DVVAQL3G"}, "file_filesize" : " (1.05MB)", "file_order" : 0, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/skoria/skoria_-_Round_Salsa.mp3", "local_path" : "/var/www/ccmixter/content/skoria/skoria_-_Round_Salsa.mp3", "file_rawsize" : 1103424}], "upload_description_plain" : "From \"Wrongtones\", Bristol 2008, samsung featurephone + tracker software + cables", "upload_description_html" : "From &#8220;Wrongtones&#8221;, Bristol 2008, samsung featurephone + tracker software + cables"},{"upload_id" : 49375, "upload_name" : "Salsa", "upload_extra" : {"u