[{"upload_id" : 69841, "upload_name" : "Joelero", "upload_extra" : {"usertags" : "ravel,bolero,orchestral,saxophone,strings,rhythm", "ccud" : "media,secret_mixter,remix,imagination_25,bpm_140_145", "systags" : "non_commercial,audio,mp3,48k,stereo,VBR", "bpm" : 140, "relative_dir" : "content/mwic", "featuring" : "", "ccplus" : true, "nsfw" : false, "num_reviews" : 7}, "user_name" : "mwic", "upload_tags" : ",media,secret_mixter,remix,imagination_25,bpm_140_145,non_commercial,audio,mp3,48k,stereo,VBR,ravel,bolero,orchestral,saxophone,strings,rhythm,", "upload_num_scores" : 14, "file_page_url" : "https://ccmixter.org/files/mwic/69841", "user_real_name" : "mwic", "artist_page_url" : "https://ccmixter.org/people/mwic", "license_logo_url" : "https://ccmixter.org/ccskins/shared/images/lics/small-by-nc-3.png", "license_url" : "https://creativecommons.org/licenses/by-nc/4.0/", "license_name" : "Attribution Noncommercial (4.0)", "upload_date_format" : "Sun, Jun 15, 2025 @ 9:24 AM", "files" : [{"file_id" : 125193, "file_upload" : 69841, "file_name" : "mwic_-_Joelero.mp3", "file_nicname" : "mp3", "file_format_info" : {"media-type" : "audio", "format-name" : "audio-mp3-mp3", "default-ext" : "mp3", "mime_type" : "audio/mpeg", "sr" : "48k", "ch" : "stereo", "ps" : "5:57", "br" : "VBR"}, "file_extra" : {"sha1" : "YWMBSUKYQ6BUMGDHVODI7442QXPFWJZ5"}, "file_filesize" : " (8.19MB)", "file_order" : 0, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/mwic/mwic_-_Joelero.mp3", "local_path" : "/var/www/ccmixter/content/mwic/mwic_-_Joelero.mp3", "file_rawsize" : 8587175}], "upload_description_plain" : "First the Good News:\r\nOne of the most well-known (and remixable) pieces by my favorite classical composer entered the public domain in January of this year. Zenboy did an impressive version of Thus Sprach Zarathustra over at MixterPlus, and I've always wanted to try that kind of thing. So I did.\r\n\r\nIt isn't an actual rendition of the score, but a kind of deconstruction, complete with mwic-style interjections, gaps, and noodling. And, of course, the great Joel Frijters udu & xaphoon sounds.\r\n\r\nNow the Bad News -- and excuses.\r\nThis idea didn't come to me until I had spent the majority of the remix period on a different concept that wasn't good and sounded bad; therefore, it's about half as long and complex as I want it to be, and I'm planning to revisit in the future.\r\n\r\nBolero is legendary for building gradually, bit by bit, to a resounding sonic apocalypse/celebration. I went a different route, making it flood and recede. Ravel's idea is cooler, but I'm still alive and he's not.", "upload_description_html" : "First the Good News:<br />\r\nOne of the most well-known (and remixable) pieces by my favorite classical composer entered the public domain in January of this year. Zenboy did an impressive version of Thus Sprach Zarathustra over at MixterPlus, and I&#8217;ve always wanted to try that kind of thing. So I did.<br />\r\n<br />\r\nIt isn&#8217;t an actual rendition of the score, but a kind of deconstruction, complete with mwic-style interjections, gaps, and noodling. And, of course, the great Joel Frijters udu & xaphoon sounds.<br />\r\n<br />\r\nNow the Bad News &#8212; and excuses.<br />\r\nThis idea didn&#8217;t come to me until I had spent the majority of the remix period on a different concept that wasn&#8217;t good and sounded bad; therefore, it&#8217;s about half as long and complex as I want it to be, and I&#8217;m planning to revisit in the future.<br />\r\n<br />\r\nBolero is legendary for building gradually, bit by bit, to a resounding sonic apocalypse/celebration. I went a different route, making it flood and recede. Ravel&#8217;s idea is cooler, but I&#8217;m still alive and he&#8217;s not."},{"upload_id" : 64859, "upload_name" : "Blue Sky Bolero", "upload_extra" : {"usertags" : "acoustic,guitar,chords,folk,rock,waltz,bolero,instrumental,music_for_film,game_music,video_music", "