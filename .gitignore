vitahuesosite-wire/
seblerskers/

# The sign-in Worker's build dependencies. Only the bundle (auth/worker.js)
# is ever deployed or committed; auth/package.json and its lockfile pin what
# produced it. The Pages workflow checks out fresh, so this never reaches the
# site artifact either.
auth/node_modules/

# Never a place to keep anything: the dev workspace's hand-off directory for
# values that have to reach a Sites secret without passing through a chat, a
# commit or a workflow artifact. The workspace is a tracked directory of this
# repository, so it is ignored here, up front, before anything is dropped in.
3rdshooter-abootonthebrave/.secrets/

# The local browser bridge's database (auth/dev-bridge.mjs). It is real
# SQLite holding whichever accounts were signed in with the fake Google, so
# it is scratch: delete it and the next sign-in creates the accounts again.
auth/.local-auth.sqlite

# Staging for sites_deploy when the thread's workspace is a subdirectory of
# the repository: the Sites tools cannot see outside it, so the built bundle
# is copied next to the manifest. A copy of auth/worker.js, never a source.
3rdshooter-abootonthebrave/vh-auth-deploy/

# Scratch space for sourcing/downloading audio (never commit these).
.cache-audio/
*.tmp.mp3
